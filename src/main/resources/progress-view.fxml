<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="progressSection" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interfaz.controller.ProgressController"
      spacing="12.0" styleClass="card-panel" visible="false" managed="false" VBox.vgrow="ALWAYS">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <FontIcon iconLiteral="mdi2p-progress-download" iconSize="18" />
            <Label text="Progreso de Descargas en Curso" styleClass="card-title" />
            <Label fx:id="downloadSpeedLabel" text="0.0 MB/s" styleClass="speed-badge" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="pauseButton" mnemonicParsing="false" onAction="#handlePauseDownload" text="Pausar" styleClass="button, warning">
               <graphic>
                  <FontIcon iconLiteral="mdi2p-pause" iconSize="14" />
               </graphic>
            </Button>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancelDownload" text="Cancelar" styleClass="button, danger">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-close-circle" iconSize="14" />
               </graphic>
            </Button>
         </children>
      </HBox>

      <!-- Tarjeta de Progreso de Playlist/Lista -->
      <VBox styleClass="progress-card">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="overallProgressLabel" text="Progreso General de Playlist" styleClass="card-subtitle" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="overallPercentageLabel" text="0%" styleClass="card-title" />
               </children>
            </HBox>
            <ProgressBar fx:id="overallProgressBar" progress="0.0" maxWidth="Infinity" styleClass="progress-bar, accent" prefHeight="10.0" />
         </children>
      </VBox>

      <!-- Tarjeta de Canción Actual -->
      <VBox styleClass="progress-card">
         <children>
            <Label fx:id="currentSongLabel" text="Esperando inicio de pista..." styleClass="card-title" wrapText="true">
               <graphic>
                  <FontIcon iconLiteral="mdi2m-music" iconSize="16" />
               </graphic>
            </Label>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="currentProgressLabel" text="Descargando..." styleClass="card-subtitle" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="currentPercentageLabel" text="0.0%" styleClass="card-title" />
               </children>
            </HBox>
            <ProgressBar fx:id="currentProgressBar" progress="0.0" maxWidth="Infinity" styleClass="progress-bar, success" prefHeight="10.0" />
         </children>
      </VBox>
   </children>
</VBox>
