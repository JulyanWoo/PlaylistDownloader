<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interfaz.controller.WelcomeController"
      alignment="CENTER" spacing="24" styleClass="welcome-container" fillWidth="false">
   <padding>
      <Insets top="40" right="20" bottom="40" left="20" />
   </padding>

   <!-- Brand Header -->
   <VBox alignment="CENTER" spacing="10">
      <HBox alignment="CENTER" spacing="12">
         <ImageView fitWidth="48" fitHeight="48" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@app.png" />
            </image>
         </ImageView>
         <Label text="Playlist Downloader" styleClass="hero-brand-text" />
      </HBox>
      <Label text="¿Qué vamos a descargar hoy?" styleClass="hero-title" />
      <Label text="Pega cualquier enlace de YouTube o lista de reproducción para comenzar al instante" styleClass="hero-subtitle" />
   </VBox>

   <!-- Hero Input Pill -->
   <HBox alignment="CENTER_LEFT" spacing="10" styleClass="hero-search-pill-container" prefWidth="680" maxWidth="680">
      <FontIcon iconLiteral="mdi2y-youtube" iconSize="26" styleClass="hero-youtube-icon" />
      <TextField fx:id="welcomeInputField" promptText="Pega aquí tu URL de YouTube..." styleClass="hero-search-input" HBox.hgrow="ALWAYS" onAction="#onWelcomeAddToQueue" />
      <Button fx:id="welcomePasteButton" mnemonicParsing="false" onAction="#onWelcomePaste" text="Pegar" styleClass="btn-dark-subtle">
         <graphic>
            <FontIcon iconLiteral="mdi2c-clipboard-text-outline" iconSize="16" />
         </graphic>
      </Button>
      <Button fx:id="welcomeAddButton" mnemonicParsing="false" onAction="#onWelcomeAddToQueue" text="+ AGREGAR" styleClass="btn-pill-primary" />
   </HBox>

   <!-- Quick Chips -->
   <HBox alignment="CENTER" spacing="12" styleClass="quick-chips-container">
      <Button mnemonicParsing="false" onAction="#onWelcomePasteAndAdd" text="📋 Pegar del Portapapeles" styleClass="quick-chip-btn" />
   </HBox>
</VBox>
