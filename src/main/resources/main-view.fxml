<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="rootNode" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.interfaz.controller.MainController" 
            styleClass="main-layout" stylesheets="@styles.css" prefWidth="920.0" prefHeight="650.0">

   <!-- Sidebar Lateral Izquierdo -->
   <left>
      <VBox styleClass="sidebar">
         <children>
            <!-- Cabecera Sidebar -->
            <HBox styleClass="sidebar-header">
               <children>
                  <ImageView fitWidth="28" fitHeight="28" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@app.png" />
                     </image>
                  </ImageView>
                  <Label text="Playlist Downloader" styleClass="app-title-text" />
               </children>
            </HBox>

            <!-- Menú de Navegación -->
            <Label text="MENÚ PRINCIPAL" styleClass="sidebar-section-title" />
            <VBox styleClass="sidebar-nav">
               <children>
                  <Button fx:id="btnNavQueue" mnemonicParsing="false" onAction="#onNavQueue" text=" Cola de Espera" styleClass="sidebar-btn, active">
                     <graphic>
                        <FontIcon iconLiteral="mdi2p-playlist-music" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnNavDownloads" mnemonicParsing="false" onAction="#onNavDownloads" text=" Descargas" styleClass="sidebar-btn">
                     <graphic>
                        <FontIcon iconLiteral="mdi2d-download-outline" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnNavLogs" mnemonicParsing="false" onAction="#onNavLogs" text=" Registros" styleClass="sidebar-btn">
                     <graphic>
                        <FontIcon iconLiteral="mdi2c-console" iconSize="18" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnNavAnalyzer" mnemonicParsing="false" onAction="#onNavAnalyzer" text=" Analizador" styleClass="sidebar-btn">
                     <graphic>
                        <FontIcon iconLiteral="mdi2f-folder-search-outline" iconSize="18" />
                     </graphic>
                  </Button>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Tarjeta de Configuración en Sidebar -->
            <VBox styleClass="sidebar-config-card">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="6">
                     <children>
                        <FontIcon iconLiteral="mdi2f-folder" iconSize="16" />
                        <Label text="Carpeta de Música" styleClass="card-title" />
                     </children>
                  </HBox>
                  <Label fx:id="musicFolderLabel" text="Desktop/MUSICA" styleClass="folder-path-text" wrapText="true" />
                  <HBox spacing="6" alignment="CENTER_LEFT">
                     <children>
                        <Button fx:id="selectFolderButton" mnemonicParsing="false" onAction="#onSelectMusicFolder" text="Cambiar" styleClass="button, sm">
                           <graphic>
                              <FontIcon iconLiteral="mdi2f-folder-open" iconSize="14" />
                           </graphic>
                        </Button>
                        <Button fx:id="resetFolderButton" mnemonicParsing="false" onAction="#onResetMusicFolder" text="Default" styleClass="button, sm">
                           <graphic>
                              <FontIcon iconLiteral="mdi2r-refresh" iconSize="14" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Tarjeta de yt-dlp Engine en Sidebar -->
            <VBox styleClass="sidebar-config-card">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="6">
                     <children>
                        <FontIcon iconLiteral="mdi2c-cloud-download" iconSize="16" />
                        <Label text="yt-dlp Engine" styleClass="card-title" />
                     </children>
                  </HBox>
                  <Label fx:id="ytDlpVersionLabel" text="Ver: Cargando..." styleClass="folder-path-text" wrapText="true" />
                  <Button fx:id="updateYtDlpButton" mnemonicParsing="false" onAction="#onUpdateYtDlp" text="Actualizar yt-dlp" styleClass="button, sm">
                     <graphic>
                        <FontIcon iconLiteral="mdi2u-update" iconSize="14" />
                     </graphic>
                  </Button>
               </children>
            </VBox>

            <!-- Cambiador de Tema en la parte inferior -->
            <HBox alignment="CENTER_LEFT" spacing="10">
               <children>
                  <Label text="Tema visual" styleClass="folder-path-text" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="themeToggleButton" mnemonicParsing="false" onAction="#onToggleTheme" styleClass="button, icon">
                     <tooltip>
                        <Tooltip text="Cambiar Tema Oscuro/Claro" />
                     </tooltip>
                     <graphic>
                        <FontIcon fx:id="themeIcon" iconLiteral="mdi2m-moon-waning-crescent" iconSize="16" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>

   <!-- Área de Contenido Principal -->
   <center>
      <VBox spacing="16.0" style="-fx-padding: 20;">
         <children>

            <!-- Tarjeta Superior: Entrada de URL y Controles de Acción -->
            <VBox styleClass="card-panel">
               <children>
                  <HBox spacing="8" alignment="CENTER_LEFT">
                     <children>
                        <FontIcon iconLiteral="mdi2l-link-variant" iconSize="18" />
                        <Label text="Enlace de YouTube o Playlist" styleClass="card-title" />
                     </children>
                  </HBox>
                  <HBox spacing="12.0" alignment="CENTER_LEFT">
                     <children>
                        <TextField fx:id="inputField" promptText="Pega aquí tu URL de YouTube..." styleClass="text-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAddToQueue" text="Agregar" styleClass="button, accent">
                           <graphic>
                              <FontIcon iconLiteral="mdi2p-plus" iconSize="16" />
                           </graphic>
                        </Button>
                        <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartDownload" text="Descargar" styleClass="button, success">
                           <graphic>
                              <FontIcon iconLiteral="mdi2p-play" iconSize="16" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- StackPane para Vistas Dinámicas Incluidas -->
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <!-- Sub-vista 1: Cola de Espera (Queue View) -->
                  <fx:include fx:id="queueView" source="queue-view.fxml" />

                  <!-- Sub-vista 2: Progreso de Descarga (Progress View) -->
                  <fx:include fx:id="progressView" source="progress-view.fxml" />

                  <!-- Sub-vista 3: Logs / Consola -->
                  <fx:include fx:id="logsSection" source="logs-view.fxml" visible="false" managed="false" />

                  <!-- Sub-vista 4: Analizador de Biblioteca -->
                  <fx:include fx:id="libraryAnalyzerView" source="library-analyzer-view.fxml" visible="false" managed="false" />
               </children>
            </StackPane>

         </children>
      </VBox>
   </center>
</BorderPane>
