<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.interfaz.controller.LogsController" styleClass="main-container" stylesheets="@styles.css" spacing="15.0" prefWidth="800.0" prefHeight="600.0">
   <children>
      <!-- Título de la ventana -->
      <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
         <ImageView fitWidth="24" fitHeight="24" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@app.png" />
            </image>
         </ImageView>
         <Label text="Consola de Logs" styleClass="app-title" style="-fx-font-size: 20px;" />
      </HBox>
      
      <!-- Área de logs -->
      <VBox VBox.vgrow="ALWAYS" styleClass="input-section hoverable-section">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <HBox spacing="10" alignment="CENTER_LEFT">
                     <FontIcon iconLiteral="mdi2f-file-document-outline" iconSize="16" styleClass="section-icon" />
                     <Label text="Logs del Sistema" styleClass="section-title" style="-fx-font-size: 14px;" />
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefreshLogs" text=" Actualizar" styleClass="secondary-button">
                     <graphic>
                        <FontIcon iconLiteral="mdi2r-refresh" iconSize="14" />
                     </graphic>
                  </Button>
                  <Button fx:id="clearLogsButton" mnemonicParsing="false" onAction="#onClearLogs" text=" Limpiar" styleClass="secondary-button">
                     <graphic>
                        <FontIcon iconLiteral="mdi2b-broom" iconSize="14" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
            
            <!-- Controles de filtrado -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 10 0;">
               <children>
                  <Label text="Filtros:" style="-fx-font-size: 12px; -fx-text-fill: #a0a0b0;" />
                  <CheckBox fx:id="showExtractAudioCheckBox" text="[ExtractAudio]" selected="true" onAction="#onFilterChanged" style="-fx-text-fill: #00ff88; -fx-font-weight: bold;" />
                  <CheckBox fx:id="showDownloadCheckBox" text="[download]" selected="true" onAction="#onFilterChanged" style="-fx-text-fill: #ff0055; -fx-font-weight: bold;" />
                  <CheckBox fx:id="showOtherLogsCheckBox" text="Otros logs" selected="true" onAction="#onFilterChanged" style="-fx-text-fill: #a0a0b0;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="resetFiltersButton" mnemonicParsing="false" onAction="#onResetFilters" text=" Restablecer" styleClass="secondary-button" style="-fx-font-size: 11px;">
                     <graphic>
                        <FontIcon iconLiteral="mdi2r-restore" iconSize="12" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
            
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" fitToHeight="true" styleClass="logs-terminal-pane" prefHeight="450.0">
               <content>
                  <TextFlow fx:id="logsTextFlow" styleClass="logs-terminal-flow" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
      
      <!-- Separador -->
      <Separator styleClass="separator" />
      
      <!-- Botones de control -->
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="saveLogsButton" mnemonicParsing="false" onAction="#onSaveLogs" text=" Guardar Logs" styleClass="start-button">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-content-save" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onClose" text=" Cerrar" styleClass="cancel-button">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-close-circle" iconSize="16" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>